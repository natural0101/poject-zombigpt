{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/pz-agent/plan.schema.json",
  "title": "PZ Agent Typed Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "summary",
    "risk_class",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "risk_class": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "action",
          "args",
          "success"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "object"
          },
          "success": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "on_failure": {
            "enum": [
              "stop",
              "ask_user",
              "replan_once",
              "skip"
            ]
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

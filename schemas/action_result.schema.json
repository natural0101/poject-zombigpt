{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/pz-agent/action-result.schema.json",
  "title": "PZ Agent Action Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "seq",
    "command_id",
    "action",
    "status",
    "reason_code",
    "timestamp_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string"
    },
    "status": {
      "enum": [
        "received",
        "accepted",
        "rejected",
        "started",
        "progress",
        "succeeded",
        "failed",
        "cancelled",
        "lost"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "started_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "finished_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "progress": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "message": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
